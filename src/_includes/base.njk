<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="cs_CZ">
<link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Allura&family=Inter:wght@300..700&family=Outfit:wght@200..700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
</head>
<body{% if theme %} data-theme="{{ theme }}"{% endif %}>
<a class="skip-link" href="#obsah">Přeskočit na obsah</a>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="logo" href="index.html" aria-label="Šárka Fekoňová — domovská stránka">
      <span class="logo__name">Šárka</span>
      <span class="logo__surname">Fekoňová</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hlavni-menu">
      <span class="visually-hidden">Otevřít menu</span>
      <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>
    <nav class="nav" id="hlavni-menu" aria-label="Hlavní menu">
      <ul class="nav__list">
        {%- for item in nav %}
        <li><a class="nav__link" href="{{ item.href }}"{% if page.filePathStem + ".html" == "/" + item.href %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
        <li class="nav__cta"><a class="btn btn--accent" href="kontakt.html">Nezávazná poptávka</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="obsah">
{{ content | safe -}}
</main>

<footer class="site-footer">
  <span class="sil sil-deco sil--dav" aria-hidden="true"></span>
  <div class="wrap site-footer__grid">
    <div>
      <a class="logo" href="index.html">
        <span class="logo__name">Šárka</span>
        <span class="logo__surname">Fekoňová</span>
      </a>
      <p class="muted" style="margin-top:1rem; max-width:26rem">Pohybová lektorka. Propojuju tanec, seberozvoj a byznys do programů šitých na míru.</p>
      <div class="social">
        <a href="https://www.instagram.com/" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="https://www.facebook.com/" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.29-.04-1.27-.12-2.41-.12-2.39 0-4.03 1.46-4.03 4.14v2.28H7.5V13h2.76v8z"/></svg>
        </a>
        <a href="https://www.linkedin.com/" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.94 8.5H4V20h2.94zM5.47 3.5a1.72 1.72 0 100 3.44 1.72 1.72 0 000-3.44M20 20h-2.93v-5.6c0-1.34-.02-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V20H10.1V8.5h2.82v1.57h.04c.39-.74 1.35-1.53 2.79-1.53 2.98 0 3.53 1.96 3.53 4.52z"/></svg>
        </a>
      </div>
    </div>
    <div>
      <h4>Kam dál</h4>
      <ul>
        <li><a href="ja-sarka.html">Já, Šárka…</a></li>
        <li><a href="pro-firmy.html">Pro firmy</a></li>
        <li><a href="pro-zeny.html">Pro ženy</a></li>
        <li><a href="pro-deti.html">Pro děti</a></li>
        <li><a href="kontakt.html">Kontakt</a></li>
        <li class="footer-link-small"><a href="byznysove-konzultace.html">Byznysové konzultace</a></li>
      </ul>
    </div>
    <div>
      <h4>Kontakt</h4>
      <ul>
        <li><a href="mailto:info@sarkafekonova.cz">info@sarkafekonova.cz</a></li>
        <li><a href="tel:+420000000000">+420 000 000 000</a></li>
        <li class="muted">Česká republika, dojíždím za vámi</li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>© <span data-year>2026</span> Šárka Fekoňová</p>
    <p>Vizuální identita: Kreativní studio Black Mango</p>
  </div>
</footer>

<script src="assets/js/main.js" defer></script>
</body>
</html>
